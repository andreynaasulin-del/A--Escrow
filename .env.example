# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (from platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Admin Telegram ID (your personal Telegram ID for receiving payment confirmations)
ADMIN_ID=123456789

# Wallet Address for receiving payments (TRC20 USDT recommended)
WALLET_ADDRESS=TRC20_or_your_wallet_address_here
